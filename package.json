    "csv",
    "etl",
    "data-cleaning",
    "automation"
  ],
  "license": "MIT",
  "author": "ContentForge",
  "homepage": "https://github.com/contentforge-press/n8n-nodes-datacheck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentforge-press/n8n-nodes-datacheck.git"
  },
  "bugs": {
    "url": "https://github.com/contentforge-press/n8n-nodes-datacheck/issues"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "nodes",
    "core",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "nodes/DataValidator.node.js"
    ],
